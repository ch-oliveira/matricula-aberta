# =========================================================================
# MATRÍCULA ABERTA · VARIÁVEIS DE AMBIENTE (PRODUÇÃO / LOCAL)
# =========================================================================

# Backend (Render / Node.js)
PORT=3333
# Se configurado, conecta no Supabase PostgreSQL. Se vazio, usa SQLite local (WAL).
# Ex.: postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
CORS_ORIGIN=*

# Segurança, Tokens de Sessão (HMAC-SHA256) e LGPD
AUTH_SECRET=
LGPD_HASH_SALT=
SEDUC_ADMIN_PASSWORDS=patos2026,seduc2026
UNIDADE_PINS=2026,patos2026

# Frontend (Vercel / Vite)
# Opcional: Se vazio, o Vercel faz o proxy automático via vercel.json rewrites.
# Se quiser conexão direta sem proxy: https://matricula-aberta-api.onrender.com
VITE_API_BASE_URL=
