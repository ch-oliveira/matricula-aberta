# =========================================================================
# MATRÍCULA ABERTA · VARIÁVEIS DE AMBIENTE (PRODUÇÃO & LOCAL)
# Município de Patos - PB (IBGE 2510808)
# =========================================================================

NODE_ENV=production
PORT=3333

# -------------------------------------------------------------------------
# 1. Banco de Dados
# -------------------------------------------------------------------------
# Se definido, conecta no PostgreSQL (Supabase, Neon, AWS RDS, Docker).
# Se deixado em branco, utiliza SQLite WAL embutido com tolerância a falhas.
# Exemplo PostgreSQL:
# DATABASE_URL=postgresql://postgres:patos2026@localhost:5432/patos_matricula?sslmode=disable
# Exemplo Supabase:
# DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# -------------------------------------------------------------------------
# 2. Segurança, Sessão e LGPD (Obrigatório gerar em Produção)
# -------------------------------------------------------------------------
# Chave mestra para assinatura HMAC dos tokens de sessão RBAC (mínimo 32 caracteres)
AUTH_SECRET=patos-producao-auth-secret-minimo-32-chars-2026

# Salt criptográfico para anonimização LGPD de telefones em alertas (mínimo 32 caracteres)
LGPD_HASH_SALT=patos-lgpd-salt-anonimizacao-segura-2026

# Credenciais de acesso da gestão municipal
SEDUC_ADMIN_PASSWORDS=patos2026,seduc2026
UNIDADE_PINS=2026,patos2026

# Origens permitidas para requisições CORS (em produção, use o domínio oficial)
# Ex.: https://matricula.patos.pb.gov.br
CORS_ORIGIN=*

# -------------------------------------------------------------------------
# 3. Notificações WhatsApp (Disparo Autônomo de Lembretes)
# -------------------------------------------------------------------------
# Se configurado, o servidor dispara mensagens via WhatsApp no dia da visita (07h00)
# e 1 hora antes do início do turno agendado.
# Se vazio, opera em modo Simulação/Mock no console sem gerar custos.
# Compatível com Meta Cloud API, Evolution API ou Z-API.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# -------------------------------------------------------------------------
# 4. Frontend PWA (Quando hospedado separadamente na Vercel)
# -------------------------------------------------------------------------
# Opcional: Se vazio, o app usa caminhos relativos /api (com proxy ou monolito)
# VITE_API_BASE_URL=https://api.matricula.patos.pb.gov.br
